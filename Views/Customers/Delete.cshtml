@model AcxiomCRM.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h3 mb-1 text-danger">Delete Customer Confirmation</h1>
                <p class="text-muted mb-0">Please confirm if you want to permanently delete this customer.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                &larr; Back to Customers
            </a>
        </div>

        <div class="alert alert-warning border-warning d-flex align-items-center mb-4" role="alert">
            <span class="fs-4 me-3">&#9888;&#65039;</span>
            <div>
                <strong>Warning!</strong> You are about to permanently delete <strong>@Model.CustomerName</strong> (@Model.CustomerCode). This action cannot be undone.
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light py-3">
                <span class="fw-semibold text-dark">Customer Summary</span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Customer Code</dt>
                    <dd class="col-sm-8 font-monospace fw-bold text-primary mb-3">@Model.CustomerCode</dd>

                    <dt class="col-sm-4 text-muted">Customer Name</dt>
                    <dd class="col-sm-8 fw-semibold text-dark mb-3">@Model.CustomerName</dd>

                    <dt class="col-sm-4 text-muted">Email Address</dt>
                    <dd class="col-sm-8 mb-3">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted">Phone Number</dt>
                    <dd class="col-sm-8 mb-3">+91 @Model.Phone</dd>

                    <dt class="col-sm-4 text-muted">Location</dt>
                    <dd class="col-sm-8 mb-3">@Model.City, @Model.State</dd>

                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8 mb-0">
                        <span class="badge bg-secondary">@Model.Status</span>
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex justify-content-end gap-2 p-3">
                <form asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CustomerId" />
                    <a asp-action="Index" class="btn btn-light border me-2">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">Delete Permanently</button>
                </form>
            </div>
        </div>
    </div>
</div>

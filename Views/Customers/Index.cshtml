@model IEnumerable<AcxiomCRM.Models.Customer>

@{
    ViewData["Title"] = "Customer Management";
    var currentFilter = ViewData["CurrentFilter"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1 text-primary">Customer Management</h1>
        <p class="text-muted mb-0">Manage customer records, company details, addresses, and statuses.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <span class="me-1">&#43;</span> Add New Customer
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-9 col-sm-8">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        &#128269;
                    </span>
                    <input type="text"
                           name="searchString"
                           value="@currentFilter"
                           class="form-control border-start-0"
                           placeholder="Search by code, name, email, phone, company, city, state, or status..."
                           aria-label="Search customers" />
                </div>
            </div>
            <div class="col-md-3 col-sm-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Search</button>
                @if (!string.IsNullOrWhiteSpace(currentFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="display-6 text-muted mb-3">&#128100;</div>
                <h5 class="text-secondary">No customers found</h5>
                @if (!string.IsNullOrWhiteSpace(currentFilter))
                {
                    <p class="text-muted">No results matched your search for "<strong>@currentFilter</strong>".</p>
                    <a asp-action="Index" class="btn btn-sm btn-outline-primary">View All Customers</a>
                }
                else
                {
                    <p class="text-muted">Get started by creating your first customer profile.</p>
                    <a asp-action="Create" class="btn btn-sm btn-primary">Create Customer</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small text-muted">
                        <tr>
                            <th scope="col" class="ps-4">Code</th>
                            <th scope="col">Customer Name</th>
                            <th scope="col">Contact</th>
                            <th scope="col">Location</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var badgeClass = item.Status switch
                            {
                                "Active" => "bg-success",
                                "Inactive" => "bg-secondary",
                                "Prospect" => "bg-info text-dark",
                                "Lead" => "bg-warning text-dark",
                                _ => "bg-light text-dark border"
                            };

                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-primary border font-monospace">
                                        @item.CustomerCode
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">
                                        <a asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none text-dark">
                                            @item.CustomerName
                                        </a>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.CompanyName))
                                    {
                                        <small class="text-muted">@item.CompanyName</small>
                                    }
                                </td>
                                <td>
                                    <div>
                                        <a href="mailto:@item.Email" class="text-decoration-none text-secondary small">
                                            @item.Email
                                        </a>
                                    </div>
                                    <small class="text-muted">+91 @item.Phone</small>
                                </td>
                                <td>
                                    <div class="text-dark">@item.City, @item.State</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 180px;" title="@item.Address">
                                        @item.Address
                                    </small>
                                </td>
                                <td>
                                    <span class="badge @badgeClass">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                            Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-primary" title="Edit Customer">
                                            Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-outline-danger" title="Delete Customer">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

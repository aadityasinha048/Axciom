@model AcxiomCRM.Models.Customer

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-md-11">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h3 mb-1 text-primary">Edit Customer</h1>
                <p class="text-muted mb-0">Update profile, address, and status for #@Model.CustomerCode.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                &larr; Back to Customers
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <input type="hidden" asp-for="CustomerId" />

                    <!-- Code & Status Header -->
                    <div class="row g-3 mb-3 p-3 bg-light rounded border">
                        <div class="col-md-6">
                            <label asp-for="CustomerCode" class="form-label fw-semibold"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="CustomerCode" class="form-control font-monospace text-uppercase" />
                            <span asp-validation-for="CustomerCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <span class="text-danger">*</span>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Prospect">Prospect</option>
                                <option value="Lead">Lead</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Customer Basic Info -->
                    <h5 class="text-secondary border-bottom pb-2 mb-3 mt-4">Basic Information</h5>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label fw-semibold"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="CustomerName" class="form-control" autofocus />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                            <span class="text-muted small">(Optional)</span>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Contact Details -->
                    <h5 class="text-secondary border-bottom pb-2 mb-3 mt-4">Contact Details</h5>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">+91</span>
                                <input asp-for="Phone" class="form-control" maxlength="10" />
                            </div>
                            <div class="form-text text-muted small">10-digit Indian mobile number (starts with 6-9).</div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Location / Address -->
                    <h5 class="text-secondary border-bottom pb-2 mb-3 mt-4">Address Details</h5>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <span class="text-danger">*</span>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="State" class="form-label fw-semibold"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="State" class="form-control" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
